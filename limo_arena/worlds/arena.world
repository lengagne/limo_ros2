<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="arena">
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Sol -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Arène : 4 murs de 3m de long et 0.4m de haut -->
    <model name="arena_walls">
      <static>true</static>

      <!-- Mur Nord (Y=1.5) -->
      <link name="north_wall">
        <pose>0 1.55 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.2 0.1 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.2 0.1 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- Mur Sud (Y=-1.5) -->
      <link name="south_wall">
        <pose>0 -1.55 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.2 0.1 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.2 0.1 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- Mur Est (X=1.5) avec ouverture -->
      <link name="east_wall_left">
        <pose>1.55 0.95 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 1.25 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 1.25 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="east_wall_right">
        <pose>1.55 -0.95 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 1.25 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 1.25 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- Mur Ouest (X=-1.5) avec ouverture -->
      <link name="west_wall_left">
        <pose>-1.55 0.95 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 1.25 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 1.25 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="west_wall_right">
        <pose>-1.55 -0.95 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 1.25 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 1.25 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
